{
  "name": "@leximeet/desktop-api-contract",
  "version": "1.0.0",
  "private": true,
  "description": "词遇 桌面本机 API 开发者设计合同",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "verify": "node tools/verify-local.cjs && node --test tests/*.test.cjs",
    "test": "node --test tests/*.test.cjs",
    "contract:generate": "node tools/contract-digest.cjs --write",
    "package:release": "npm run format:check && npm run verify && node tools/package-release.cjs",
    "verify:release": "node tools/package-release.cjs --verify",
    "format": "prettier --write \"{tools,tests}/**/*.cjs\" \".github/**/*.yml\" \"*.md\" \"docs/**/*.md\" \"{package.json,.prettierrc.json}\"",
    "format:check": "prettier --check \"{tools,tests}/**/*.cjs\" \".github/**/*.yml\" \"*.md\" \"docs/**/*.md\" \"{package.json,.prettierrc.json}\""
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prettier": "3.8.3"
  }
}
